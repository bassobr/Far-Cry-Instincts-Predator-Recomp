}
template <class T>
constexpr int bit_width(T v) noexcept {
  return static_cast<int>(sizeof(T) * 8) - countl_zero(v);
}
template <class T>
constexpr bool has_single_bit(T v) noexcept {
  return v != 0 && (v & (v - 1)) == 0;
}
template <class T>
constexpr T bit_floor(T v) noexcept {
  return v == 0 ? 0 : static_cast<T>(T(1) << (bit_width(v) - 1));
}
template <class T>
constexpr T bit_ceil(T v) noexcept {
  return v <= 1 ? T(1) : static_cast<T>(T(1) << bit_width(static_cast<T>(v - 1)));
}
template <class T>
constexpr T rotl(T v, int s) noexcept {
  constexpr int n = sizeof(T) * 8;
  const int r = s % n;
  if (r == 0) return v;
  if (r > 0) return static_cast<T>((v << r) | (v >> (n - r)));
  return static_cast<T>((v >> -r) | (v << (n + r)));
}
template <class T>
constexpr T rotr(T v, int s) noexcept {
  return rotl(v, -s);
}
