# Manifest for `rexglue codegen`, generated by CMake from config/predator/predator_manifest.toml.in.
# Do not edit by hand: paths come from the build (FCP_GAME_DIR, FCP_GENERATED_DIR), the title
# configuration is in config/predator/default.toml. Codegen writes [project].sdk_version itself;
# the value here is already the one the frozen SDK version writes.

[project]
name = "predator"
sdk_version = "@FCP_REXGLUE_SDK_VERSION@"
game_root = "@FCP_GAME_DIR@"
hook_sources = ["@FCP_SOURCE_DIR@/src"]

[entrypoint]
file_path = "@FCP_GAME_DIR@/default.xex"
out_directory_path = "@FCP_GENERATED_DIR@/default"
includes = [
  "@FCP_SOURCE_DIR@/config/predator/default.toml",
  # [function_names] from config/predator/d3d_symbols.toml (cmake/fcp_d3d_names.cmake)
  "@FCP_GENERATED_DIR@/d3d_names.toml",
]
