# Writes fcp_version.h (commit, dirty flag, build time) when it changed. Run with cmake -P:
#   -DFCP_SOURCE_DIR=<repo> -DFCP_OUT=<header> -DFCP_CONFIG=<config>
execute_process(
  COMMAND git rev-parse --short=10 HEAD
  WORKING_DIRECTORY "${FCP_SOURCE_DIR}"
  OUTPUT_VARIABLE commit
  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET
)
execute_process(
  COMMAND git status --porcelain --untracked-files=no
  WORKING_DIRECTORY "${FCP_SOURCE_DIR}"
  OUTPUT_VARIABLE status
  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET
)
if (commit STREQUAL "")
  set(commit "unknown")
endif ()
if (status STREQUAL "")
  set(dirty 0)
else ()
  set(dirty 1)
endif ()
string(TIMESTAMP now "%Y-%m-%d %H:%M:%S")
set(text "// Generated by cmake/fcp_version.cmake\n#pragma once\n#define FCP_GIT_COMMIT \"${commit}\"\n#define FCP_GIT_DIRTY ${dirty}\n#define FCP_BUILD_CONFIG \"${FCP_CONFIG}\"\n")
# The build time changes on every build; keep it in a separate line that only changes with the rest.
set(old "")
if (EXISTS "${FCP_OUT}")
  file(READ "${FCP_OUT}" old)
endif ()
string(REGEX REPLACE "#define FCP_BUILD_TIME [^\n]*\n" "" old_rest "${old}")
if (NOT old_rest STREQUAL text)
  file(WRITE "${FCP_OUT}" "${text}#define FCP_BUILD_TIME \"${now}\"\n")
endif ()
