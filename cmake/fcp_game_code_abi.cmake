# Writes fcp_game_code_abi.h when it changed (run with cmake -P on every build, like fcp_version.cmake):
#   -DFCP_SOURCE_DIR=<repo> -DFCP_OUT=<header> -DFCP_EXTRA=<text: march, compiler version, PGO profile hash>
#
# FCP_GAME_CODE_ABI: SHA-256 over everything that decides the generated code and how it is compiled: the SDK
# headers (rexglue/include, with rex/guest_std), the codegen (rexglue/src/codegen, the templates), the title
# configuration, the DLL entry and its import lists (src/fcp/game_code), the interface (game_code_abi.h), the
# build driver with its flags (game_code_build.cpp) and FCP_EXTRA. predator_code.dll carries the value it was built
# with; predator.exe builds a new one when the values differ (src/fcp/game_code.cpp). A release changes it only
# when one of these changed, so a player rebuilds the game code only then.
# Also: SHA-256 and size of default.xex from config/predator/disc.toml, the SDK version codegen writes.
set(globs
    "rexglue/include/*"
    "rexglue/src/codegen/*"
    "rexglue/resources/templates/*"
    "src/fcp/game_code/*"
)
set(files
    "config/predator/default.toml"
    "config/predator/d3d_symbols.toml"
    "config/predator/disc.toml"
    "src/fcp/game_code_abi.h"
    "src/fcp/game_code_build.cpp"
    "tools/boot/gen_d3d_names.py"
)
foreach (g IN LISTS globs)
  file(GLOB_RECURSE found RELATIVE "${FCP_SOURCE_DIR}" "${FCP_SOURCE_DIR}/${g}")
  list(APPEND files ${found})
endforeach ()
list(REMOVE_DUPLICATES files)
list(SORT files)
set(text "${FCP_EXTRA}\n")
foreach (f IN LISTS files)
  file(SHA256 "${FCP_SOURCE_DIR}/${f}" h)
  string(APPEND text "${h} ${f}\n")
endforeach ()
string(SHA256 abi "${text}")
string(TOUPPER "${abi}" abi)

file(READ "${FCP_SOURCE_DIR}/config/predator/disc.toml" disc)
string(REGEX MATCH "sha256 *= *\"([0-9A-Fa-f]+)\"" _ "${disc}")
set(xex_sha256 "${CMAKE_MATCH_1}")
string(TOUPPER "${xex_sha256}" xex_sha256)
string(REGEX MATCH "size *= *([0-9]+)" _ "${disc}")
set(xex_size "${CMAKE_MATCH_1}")
if (NOT xex_sha256 OR NOT xex_size)
  message(FATAL_ERROR "config/predator/disc.toml: [default_xex] sha256/size not found")
endif ()

set(out "// Generated by cmake/fcp_game_code_abi.cmake. Do not edit.\n#pragma once\n")
string(APPEND out "#define FCP_GAME_CODE_ABI \"${abi}\"\n")
string(APPEND out "#define FCP_DISC_XEX_SHA256 \"${xex_sha256}\"\n")
string(APPEND out "#define FCP_DISC_XEX_SIZE ${xex_size}ull\n")
string(APPEND out "#define FCP_REXGLUE_SDK_VERSION \"${FCP_SDK_VERSION}\"\n")
list(LENGTH files n)
string(APPEND out "#define FCP_GAME_CODE_ABI_INPUTS ${n}\n")
set(old "")
if (EXISTS "${FCP_OUT}")
  file(READ "${FCP_OUT}" old)
endif ()
if (NOT old STREQUAL out)
  file(WRITE "${FCP_OUT}" "${out}")
endif ()
